# Образец .env для сервера. Скопировать в .env на сервере и заполнить.
# ВСЕ значения СМЕНИТЬ. Реальный .env в Git не попадает.
POSTGRES_DB=jewelry
POSTGRES_USER=jewelry
POSTGRES_PASSWORD=придумайте-длинный-пароль
SECRET_KEY=длинная-случайная-строка
DEBUG=False
ALLOWED_HOSTS=IP-СЕРВЕРА
CSRF_TRUSTED_ORIGINS=http://IP-СЕРВЕРА
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://IP-СЕРВЕРА
